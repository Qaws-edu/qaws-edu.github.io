rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // بريد مس أسماء (نفس الذي أُنشئ في Authentication)
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'asmaaboelftooh@gmail.com';
    }

    // محتوى لوحة التحكم: المنشور يقرأه الجميع، ولا يكتب أحد إلا مس أسماء
    match /cmsLive/{docId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
    match /cmsDraft/{docId} {
      allow read, create, update, delete: if isOwner();
    }
    match /cmsHistory/{docId} {
      allow read, create, delete: if isOwner();
      allow update: if false;
    }

    // كل طالب له وثيقة بمعرّف دخوله المجهول: يقرأ ويكتب وثيقته فقط
    match /students/{studentId} {
      allow read: if isOwner()
        || (request.auth != null && request.auth.uid == studentId);
      allow create, update: if request.auth != null
        && request.auth.uid == studentId
        && request.resource.data.keys().hasOnly(['name', 'lastActive'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isOwner()
          || (request.auth != null && request.auth.uid == studentId);
        allow create: if request.auth != null
          && (request.auth.uid == studentId || isOwner())
          && request.resource.data.keys().hasOnly(['from', 'text', 't'])
          && request.resource.data.from in ['student', 'owner']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }
  }
}

