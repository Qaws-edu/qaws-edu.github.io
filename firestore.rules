rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // بريد مس أسماء (نفس الذي أُنشئ في Authentication)
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'asmaaboelftooh@gmail.com';
    }

    // كل طالب له وثيقة بمعرّف دخوله المجهول: يقرأ ويكتب وثيقته فقط
    match /students/{studentId} {
      allow read: if isOwner()
        || (request.auth != null && request.auth.uid == studentId);
      allow create, update: if request.auth != null
        && request.auth.uid == studentId
        && request.resource.data.keys().hasOnly(['name', 'lastActive'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isOwner()
          || (request.auth != null && request.auth.uid == studentId);
        allow create: if request.auth != null
          && (request.auth.uid == studentId || isOwner())
          && request.resource.data.keys().hasOnly(['from', 'text', 't'])
          && request.resource.data.from in ['student', 'owner']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }
    // الإشعارات: الطالب يقرأ إشعاراته والعامة فقط، والمعلّمة تقرأ إشعارات النشاط
    match /notifications/{notifId} {
      allow read: if isOwner()
        || (request.auth != null && resource.data.to in ['all', request.auth.uid]);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['to', 'kind', 'text', 't'])
        && request.resource.data.to is string
        && request.resource.data.kind in ['chat', 'reply', 'exam', 'signup', 'content']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200
        && request.resource.data.t == request.time
        && (request.resource.data.to in ['owner', request.auth.uid] || isOwner());
      allow update, delete: if false;
    }

  }
}
